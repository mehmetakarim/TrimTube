{
  "name": "trimtube",
  "productName": "TrimTube",
  "version": "1.25.1",
  "description": "YouTube video indirme ve kesme aracı (yt-dlp + ffmpeg)",
  "main": "main.js",
  "author": {
    "name": "mehmetakarim",
    "email": "mehmetakarim@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/test.cjs --integration",
    "fetch:win": "node scripts/fetch-ytdlp.js win32 && node scripts/fetch-ema.js",
    "fetch:mac": "node scripts/fetch-ytdlp.js darwin && node scripts/fetch-ema.js",
    "fetch:linux": "node scripts/fetch-ytdlp.js linux && node scripts/fetch-ema.js",
    "build:win": "npm run fetch:win && electron-builder --win",
    "build:mac": "npm run fetch:mac && electron-builder --mac",
    "build:linux": "npm run fetch:linux && electron-builder --linux"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.140",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mehmetakarim.trimtube",
    "afterPack": "scripts/after-pack.js",
    "productName": "TrimTube",
    "asar": false,
    "compression": "maximum",
    "protocols": [
      {
        "name": "TrimTube",
        "schemes": ["trimtube"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mehmetakarim",
      "repo": "TrimTube"
    },
    "files": [
      "**/*",
      "!design/**",
      "!scripts/**",
      "!.github/**",
      "!.claude/**",
      "!resources/**",
      "!dist/**",
      "!build/**",
      "!*.onnx",
      "!tracker.spec",
      "!*.md",
      "!*.bat",
      "!requirements.txt",
      "!extension/**",
      "!.venv/**",
      "!tools/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxil.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"],
      "extraResources": [
        { "from": "resources/bin/win", "to": "bin" },
        { "from": "resources/ema", "to": "ema" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.video",
      "extraResources": [
        { "from": "resources/bin/mac", "to": "bin" },
        { "from": "resources/ema", "to": "ema" }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["deb"],
      "category": "AudioVideo",
      "extraResources": [
        { "from": "resources/bin/linux", "to": "bin" },
        { "from": "resources/ema", "to": "ema" }
      ]
    }
  }
}
